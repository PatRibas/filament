material {
    name : ComputeTexture,
    domain : compute,
    groupSize : [8, 8, 1],
    parameters : [
        {
            type : float,
            name : time
        }
    ],
    images : [
        {
            name : outputTexture,
            format : rgba8
        }
    ]
}

compute {
    void compute() {
    uvec2 gridId = gl_GlobalInvocationID.xy;
    vec2 imgSize = vec2(imageSize(outputTexture));

    if (gridId.x >= uint(imgSize.x) || gridId.y >= uint(imgSize.y)) {
        return;
    }

    float time = materialParams.time;

    // Adapted from https://en.wikipedia.org/wiki/Mandelbrot_set and https://en.wikipedia.org/wiki/Plotting_algorithms_for_the_Mandelbrot_set
    vec2 normalizedGridId = (vec2(gridId) + vec2(0.5)) / vec2(imgSize);
    vec2 c = (normalizedGridId - vec2(0.5)) * 2.0 - vec2(1.0, 0.0);

    vec2 z = vec2(0.0, 0.0);
    float i;
    for (i = 0.0; i < 1.0; i += 0.005) {
        z = vec2(
            z.x * z.x - z.y * z.y + c.x,
            z.y * z.x + z.x * z.y + c.y
        );

        // Numbers that diverge "quickly" towards infinity are not in the Mandelbrot set
        // If this `break` is hit, then the complex number `z` diverged too quickly. 
        // `i < 1.0` means the number is not in the set
        if (length(z) > 4.0) {
            break;
        }
    }

    vec3 red = vec3(234.0, 67.0, 53.0) / 255.0;
    vec3 yellow = vec3(251.0, 188.0, 4.0) / 255.0;
    vec3 green = vec3(52.0, 168.0, 83.0) / 255.0;
    vec3 blue = vec3(66.0, 133.0, 244.0) / 255.0;
    vec3 rgb = vec3(0.0, 0.0, 0.0);

    // Color the texture arbitrarily based on *how* quickly the out-of-set number diverged
    if (i < 1.0) {
        // There is no logic here. Numbers were fiddled with until it looked cool 
        float t = (log(i) * sin(2.0 * abs(mod(time / 4.0, 1.0) - 0.5))) * 2.0 + 1.5;
        rgb = mix(red, mix(yellow, mix(green, blue, t), t), t);
    }

    vec4 color = vec4(rgb, 1.0);
    imageStore(outputTexture, ivec2(gridId), color);    
    }
}
