material {
    name : ComputeParticles,
    domain : compute,
    groupSize : [64, 1, 1],
    parameters : [
        {
            type : float,
            precision : high,
            name : deltaTime
        },
        {
            type : uint,
            precision : high,
            name : count
        }
    ],
    buffers : [
        {
            name : Positions,
            qualifiers : [],
            fields : [
                { name : data, type : float4[], precision : high }
            ]
        },
        {
            name : Velocities,
            qualifiers : [],
            fields : [
                { name : data, type : float4[], precision : high }
            ]
        },
        {
            name : Colors,
            qualifiers : [],
            fields : [
                { name : data, type : float4[], precision : high }
            ]
        }
    ]
}

compute {
    void compute() {
        uint index = gl_GlobalInvocationID.x;

        if (index >= materialParams.count) {
            return;
        }

        vec3 pos = positions.data[index].xyz;
        vec3 vel = velocities.data[index].xyz;

        float dt = materialParams.deltaTime;
        pos += vel * dt;

        const float bound = 1.5;
        if (pos.x < -bound) { pos.x = -bound; vel.x = -vel.x; }
        if (pos.x >  bound) { pos.x =  bound; vel.x = -vel.x; }
        if (pos.y < -bound) { pos.y = -bound; vel.y = -vel.y; }
        if (pos.y >  bound) { pos.y =  bound; vel.y = -vel.y; }
        if (pos.z < -bound) { pos.z = -bound; vel.z = -vel.z; }
        if (pos.z >  bound) { pos.z =  bound; vel.z = -vel.z; }

        positions.data[index] = vec4(pos, 1.0);
        velocities.data[index] = vec4(vel, 0.0);
        colors.data[index] = vec4(clamp(pos * 0.5 + 0.5, 0.05, 1.0), 1.0);
    }
}
